{
  "expo": {
    "name": "PLAY",
    "slug": "playbyte",
    "version": "1.0.0",
    "scheme": "playbyte",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.playbyte.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Share your PLAY moment results."
      }
    },
    "android": {
      "package": "app.playbyte.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#150E2B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d4604f3d-6fb5-4a81-acf6-5843ceea2fb5"
      }
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.playbyte-android-only"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#150E2B",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ]
  }
}
