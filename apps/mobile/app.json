{
  "expo": {
    "name": "MAJA",
    "slug": "maja",
    "version": "1.0.0",
    "scheme": "maja",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.maja.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Share your MAJA moment results."
      }
    },
    "android": {
      "package": "app.maja.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#150E2B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0281a553-56b1-4c0b-b55a-2194e66c1ff0"
      }
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "MAJA uses this to measure which ads brought you here and to show you more relevant ads."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.maja-android-only"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#150E2B",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "owner": "anish2607s-team"
  }
}
