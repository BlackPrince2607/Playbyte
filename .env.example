# Maja environment template — copy to `.env` and fill values.
# Never commit real secrets. Use separate values per environment (dev / staging / production).

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# development | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API (backend + worker)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Public HTTPS URL in staging/production (used for share card URLs when on local storage)
API_PUBLIC_URL=http://localhost:8000
# Comma-separated origins — no wildcards in production
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Postgres — Supabase pooler recommended for API
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Sync URI for psql/scripts
DATABASE_URL_SYNC=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Guest sessions (secret — backend only)
GUEST_TOKEN_SECRET=change-me-guest-token-secret
GUEST_SESSION_TTL_HOURS=720
ACCOUNT_PROMPT_AFTER=3

# Supabase (backend)
# New API keys (recommended): publishable = sb_publishable_…, secret = sb_secret_…
# Legacy names still used as env vars — map values as follows:
#   SUPABASE_ANON_KEY          <- publishable key (sb_publishable_…)  [optional for API]
#   SUPABASE_SERVICE_ROLE_KEY  <- secret key (sb_secret_…)            [required for storage]
# Legacy JWT anon/service_role keys still work if you have not migrated.
# SUPABASE_JWT_SECRET is optional when the project uses asymmetric JWT signing keys
# (ES256/RS256). The API verifies those via SUPABASE_URL/.../jwks.json.
# Keep the legacy JWT secret set if you still issue HS256 access tokens.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional override; defaults to {SUPABASE_URL}/auth/v1 for JWKS tokens
SUPABASE_JWT_ISSUER=
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
SUPABASE_STORAGE_BUCKET_SHARES=share-cards
SUPABASE_STORAGE_BUCKET_EXPORTS=exports

# Admin CMS API key — development/automation only; blocked for admin routes in production.
# The default value and keys shorter than 32 chars are ignored: generate one to use X-Admin-Key.
ADMIN_API_KEY=dev-admin-key
ADMIN_ORIGIN=http://localhost:3000

# Rate limits (backend)
RATE_LIMIT_RESPONSE_PER_MINUTE=60
RATE_LIMIT_GUEST_CREATE_PER_HOUR=30

# Content agent (backend and the feed refresh job — never commit a real key)
# An sk-or- key is an OpenRouter key. Leave BASE_URL empty and the client uses OpenRouter.
# A platform.openai.com key uses https://api.openai.com/v1 and model gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Observability (backend — optional)
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat (backend only). Leave blank until coin packs are configured in App Store Connect and Play Console.
# REVENUECAT_SECRET_API_KEY verifies purchases. REVENUECAT_WEBHOOK_AUTHORIZATION is the full
# Authorization header value set on the RevenueCat webhook (for example "Bearer <secret>").
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=

# Push (backend — optional for MVP)
APNS_KEY_ID=
APNS_TEAM_ID=
FCM_PROJECT_ID=

# -----------------------------------------------------------------------------
# Admin CMS (Next.js) — public vars only; no service role
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Mobile (Expo) — public vars only; no service role
# -----------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web OAuth client ID from Google Cloud (required for Android Google Sign-In)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# RevenueCat public SDK keys, one per store. Empty hides live purchases; the coin wallet still works.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# PostHog product analytics (project API key / token). Empty = capture is a no-op.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
